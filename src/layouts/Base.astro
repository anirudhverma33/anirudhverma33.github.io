---
import '@fontsource/kanit/latin-300.css';
import '@fontsource/kanit/latin-300-italic.css';
import '@fontsource/kanit/latin-400.css';
import '@fontsource/kanit/latin-500.css';
import '@fontsource/kanit/latin-600.css';
import '@fontsource/kanit/latin-800.css';
import '@fontsource/kanit/latin-900.css';
import '../styles/global.css';
import { existsSync } from 'node:fs';
import { Github, GraduationCap, Linkedin } from 'lucide-react';
import { getImage } from 'astro:assets';
import headshot from '../assets/photo-home.jpg';
import { person, profiles, url, verification } from '../lib/site';

interface Props {
  title?: string;
  /** Full <title> override (the homepage uses this to put name and affiliation first). */
  pageTitle?: string;
  description: string;
  jsonLd?: object;
  /** Homepage: full-bleed sections (the shared site header is still shown). */
  home?: boolean;
}

const { title, pageTitle, description, jsonLd, home = false } = Astro.props;
const fullTitle = pageTitle ?? (title ? `${title} | ${person.name}` : person.name);
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const hasCv = existsSync('public/cv.pdf');

const ml = '/research/machine-learning/';
const nav = [
  { href: '/research/', label: 'Research', short: 'Research', current: path.startsWith('/research/') && !path.startsWith(ml) },
  { href: ml, label: 'Machine learning', short: 'ML', current: path.startsWith(ml) },
  { href: '/papers/', label: 'Papers', short: 'Papers', current: path.startsWith('/papers/') },
  { href: '/about/', label: 'About', short: 'About', current: path.startsWith('/about/') },
];
const icons: Record<string, typeof Github | null> = { 'Google Scholar': GraduationCap, ORCID: null, GitHub: Github, LinkedIn: Linkedin };
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Preview image for search results and link cards.
const ogImage = Astro.site ? new URL((await getImage({ src: headshot, width: 600, format: 'jpeg' })).src, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="author" content={person.name} />
    <meta name="robots" content="index, follow" />
    {verification.google && <meta name="google-site-verification" content={verification.google} />}
    {verification.bing && <meta name="msvalidate.01" content={verification.bing} />}
    <link rel="sitemap" href={url('/sitemap.xml')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={home ? 'profile' : 'website'} />
    <meta property="og:site_name" content={person.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={`${person.name}, IISc Bengaluru`} />}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0c0c0c" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar wrap">
        <a class="home" href={url('/')} aria-current={path === '/' ? 'page' : undefined}>{person.name}</a>
        <ul class="profiles" aria-label="Profiles">
          {
            profiles.map((pr) => {
              const Icon = icons[pr.label];
              return (
                <li>
                  <a href={pr.href} aria-label={pr.label} title={pr.label}>
                    {Icon ? (
                      <Icon size={18} strokeWidth={1.75} aria-hidden="true" />
                    ) : (
                      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.75" /><text x="12" y="16" text-anchor="middle" font-size="10" font-weight="700" fill="currentColor" font-family="Kanit, sans-serif">iD</text></svg>
                    )}
                  </a>
                </li>
              );
            })
          }
        </ul>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={url(item.href)} aria-current={item.current ? 'page' : undefined}>
                    <span class="long">{item.label}</span><span class="short">{item.short}</span>
                  </a>
                </li>
              ))
            }
            {hasCv && (
              <li>
                <a href={url('/cv.pdf')}>CV</a>
              </li>
            )}
            <li>
              <a class="contact" href={`mailto:${person.email}`}>Contact</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class:list={{ landing: home }}>
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div class="inner">
      <p>
        {person.name} · {person.role}
        <br />
        <a href={`mailto:${person.email}`}>{person.email}</a>
      </p>
      <ul>
        {profiles.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
      </ul>
      <p class="fine">
        Figures from published papers are reproduced with citation. Numbers on this site are quoted from the cited sources.
      </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(12, 12, 12, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
    font-family: var(--sans);
    font-size: var(--s-14);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 24px;
  }
  .site-header a {
    color: var(--ink);
    text-decoration: none;
    display: inline-block;
    padding: 14px 0 12px;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .site-header .home { font-weight: 600; }
  .site-header a:hover { border-bottom-color: var(--hairline); }
  .site-header a[aria-current='page'] { border-bottom-color: #c9b8ff; }
  .site-header .home[aria-current='page'] { border-bottom-color: transparent; }
  .site-header .contact { color: #c9b8ff; }
  .profiles { display: flex; gap: 14px; list-style: none; margin: 0; padding: 0; order: 3; }
  .profiles a { color: var(--graphite); padding: 14px 0 12px; display: inline-flex; align-items: center; }
  .profiles a:hover { color: var(--ink); border-bottom-color: transparent; }
  .profiles :global(svg) { display: block; }
  .home { order: 1; }
  nav { order: 2; margin-left: auto; }
  nav ul { display: flex; gap: 16px; list-style: none; margin: 0; padding: 0; }
  .short { display: none; }
  @media (max-width: 1023px) {
    .bar { justify-content: space-between; }
    .home { padding-bottom: 0 !important; }
    .profiles { order: 2; }
    .profiles a { padding-bottom: 0; }
    nav { order: 3; width: 100%; margin-left: 0; overflow-x: auto; scrollbar-width: none; }
    nav ul { justify-content: center; gap: 14px; font-size: 0.8rem; }
    .long { display: none; }
    .short { display: inline; }
  }
  @media (min-width: 1024px) {
    .site-header { font-size: var(--s-15, 0.95rem); }
    nav ul { gap: 26px; }
    .profiles { margin-left: 8px; padding-left: 22px; border-left: 1px solid var(--hairline); }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    nav ul { justify-content: flex-start; gap: 22px; font-size: var(--s-14); }
  }

  .site-footer {
    margin-top: var(--section);
    padding-bottom: 48px;
    font-family: var(--sans);
    font-size: var(--s-14);
    color: var(--graphite);
  }
  .site-footer .inner { border-top: 1px solid var(--hairline); padding-top: 32px; }
  .site-footer a { color: var(--ink); }
  .site-footer ul { display: flex; flex-wrap: wrap; gap: 4px 24px; list-style: none; padding: 0; margin: 0 0 16px; }
  .site-footer a { display: inline-block; padding: 8px 0; }
  .site-footer p { margin: 0 0 8px; }
  .site-footer .fine { max-width: 60ch; }
</style>
