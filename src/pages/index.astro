---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import HeroSection from '../components/home/HeroSection';
import AboutSection from '../components/home/AboutSection';
import ExperienceSection from '../components/home/ExperienceSection';
import ProjectsSection from '../components/home/ProjectsSection';
import type { Img, ProjectData } from '../components/home/types';
import sketch from '../assets/portrait-sketch.jpg';
import avatar from '../assets/portrait-avatar.jpg';
import { person, profiles, url } from '../lib/site';
import { projects, methodLabel, mlProjects } from '../lib/projects';
import { publications, statusText } from '../lib/publications';
import { experience } from '../lib/cv';
import { figuresByProject } from '../lib/gallery';

async function img(src: ImageMetadata, alt: string, widths: number[]): Promise<Img> {
  const w = widths.filter((x) => x <= src.width);
  const out = await getImage({ src, widths: w.length ? w : [src.width], format: 'webp' });
  return { src: out.src, srcSet: out.srcSet.attribute, width: src.width, height: src.height, alt };
}

// Hero: pencil sketch generated from portrait.jpg (4:5, 1280 x 1600).
const sketchImg: Img = {
  src: (await getImage({ src: sketch, width: 800, format: 'webp' })).src,
  srcSet: (await getImage({ src: sketch, widths: [440, 800, 1280], format: 'webp' })).srcSet.attribute,
  width: 1280,
  height: 1600,
  alt: 'Pencil sketch of Anirudh Verma.',
};

// About: small circular photo (portrait-avatar.jpg is a square face crop of portrait.jpg).
const photoCrop = await getImage({ src: avatar, width: 320, format: 'webp' });
const photoImg: Img = { src: photoCrop.src, width: 320, height: 320, alt: 'Anirudh Verma on a bridge above a forested river valley.' };

const projectData: ProjectData[] = await Promise.all(
  projects.map(async (p) => {
    const pub = p.publication ? publications.find((x) => x.id === p.publication) : undefined;
    const status = pub ? statusText(pub) : p.period;
    return {
      slug: p.slug,
      href: url(`/research/${p.slug}/`),
      category: `${methodLabel[p.method]} · ${status}`,
      title: p.title,
      summary: p.summary,
      status,
      images: await Promise.all(figuresByProject[p.slug].slice(0, 3).map((f) => img(f.src, f.alt, [480, 800, 1200]))),
    };
  }),
);

// Homepage shows the main research roles; the full list is on /about/.
const mainExperience = experience.filter((e) => !e.place.startsWith('Mondal Lab'));

const contact = `mailto:${person.email}`;
const links = { about: '#about', research: '#research', papers: url('/papers/'), contact };
const aboutText =
  "I studied physics at IISc Bengaluru (BS and MS) and now work there as a project assistant in the Quantum Optics & Quantum Information Lab. Much of my work is with entangled photons. I worked on a four-qubit photonic setup that produces random numbers anyone can check, and on using it to simulate Popescu–Rohrlich correlations. I also wrote a paper, now under review, that describes gluon scattering amplitudes as quantum walks. My MS thesis was computational, simulating free fermions under continuous measurement. Outside physics, I've been teaching myself machine learning and have built a few projects along the way, including a fine-tuned T5 summariser and a small RAG pipeline.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  email: `mailto:${person.email}`,
  affiliation: { '@type': 'Organization', name: 'Indian Institute of Science, Bengaluru' },
  sameAs: profiles.map((p) => p.href),
  knowsAbout: person.areas,
};
---

<Base
  home
  description="Anirudh Verma: photonic quantum information, quantum foundations, quantum walks, open quantum many-body systems and applied machine learning. Research, papers and contact."
  jsonLd={jsonLd}
>
  <HeroSection
    client:load
    name={person.name}
    current="Project assistant · QOQI Lab, IISc Bengaluru"
    intro="I work on quantum optics and quantum information, mostly with entangled photons and quantum walks. On the side, I build machine-learning projects."
    portrait={sketchImg}
    links={links}
    cv={url('/cv.pdf')}
    profiles={profiles}
  />
  <AboutSection client:visible photo={photoImg} text={aboutText} role={person.role} contact={contact} />
  <ExperienceSection client:visible items={mainExperience} moreHref={url('/about/')} />
  <ProjectsSection client:visible projects={projectData} />

  <section aria-labelledby="ml-home-h" class="bg-[#0C0C0C] px-5 pb-10 pt-10 sm:px-8 md:px-10">
    <h2
      id="ml-home-h"
      class="hero-heading mb-12 text-center font-black uppercase leading-none tracking-tight sm:mb-16"
      style="font-size: clamp(2.25rem, 6vw, 84px)"
    >
      Machine learning
    </h2>
    <ol class="mx-auto max-w-5xl list-none">
      {
        mlProjects.map((m, i) => (
          <li class="flex flex-col gap-2 py-7 sm:flex-row sm:gap-10" style={i ? 'border-top: 1px solid rgba(215, 226, 234, 0.15)' : undefined}>
            <p class="shrink-0 text-sm font-medium uppercase tracking-widest text-[#8E9AA3] sm:w-24 sm:pt-1">{String(i + 1).padStart(2, '0')}</p>
            <div class="flex flex-col gap-2">
              <h3 class="font-medium leading-snug text-[#D7E2EA]" style="font-size: clamp(1rem, 1.8vw, 1.5rem)">
                <a href={url(`/research/machine-learning/#${m.anchor}`)} class="text-[#D7E2EA] no-underline transition-opacity duration-200 hover:opacity-70">{m.title}</a>
              </h3>
              <p class="text-sm font-light text-[#D7E2EA]/70 sm:text-base">{m.summary}</p>
              {m.result && <p class="text-sm font-light text-[#D7E2EA] sm:text-base">{m.result}</p>}
              <p class="text-xs font-light uppercase tracking-widest text-[#8E9AA3] sm:text-sm">{m.stack}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mx-auto mt-10 max-w-5xl text-center">
      <a
        href={url('/research/machine-learning/')}
        class="inline-flex items-center gap-2 rounded-full border-2 border-solid border-[#D7E2EA] px-8 py-3 text-sm font-medium uppercase tracking-widest text-[#D7E2EA] no-underline transition-colors duration-200 hover:bg-[#D7E2EA]/10 sm:px-10 sm:py-3.5 sm:text-base"
      >
        Machine learning case study
      </a>
    </p>
  </section>

</Base>
